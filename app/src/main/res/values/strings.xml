    <string name="battery_setup_title">Background Reliability Guide</string>
    <string name="battery_setup_headline">Keep SkyPay Running 24/7</string>
    <string name="battery_setup_body">Certain device manufacturers (such as Xiaomi, Samsung, Oppo, Vivo, and OnePlus) enforce aggressive background task termination that can kill foreground services. Follow these instructions to ensure high reliability:</string>
    <string name="battery_step1_title">1. Disable Android Battery Optimization</string>
    <string name="battery_step1_desc">Exempt SkyPay from system Doze and App Standby modes.</string>
    <string name="battery_step1_btn">Open Battery Optimization</string>
    <string name="battery_step2_title">2. Lock SkyPay in Recent Apps</string>
    <string name="battery_step2_desc">Open the Recent Apps / Overview screen, long press SkyPay, and tap the Lock icon.</string>
    <string name="battery_step3_title">3. Allow Auto-Start / Background Launch</string>
    <string name="battery_step3_desc">In your device settings, enable Auto-Start and allow background activity for SkyPay.</string>
    <string name="battery_step3_btn">Open App System Settings</string>
    
