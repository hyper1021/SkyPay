<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <EditText
        android:id="@+id/etRowKey"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="center_vertical"
        android:hint="Key"
        android:imeOptions="actionNext"
        android:inputType="textNoSuggestions"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextTertiary"
        android:textSize="13sp" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/colorCardBorder" />

    <EditText
        android:id="@+id/etRowValue"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="center_vertical"
        android:hint="Value"
        android:imeOptions="actionDone"
        android:inputType="textNoSuggestions"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:singleLine="true"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextTertiary"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/ivDeleteRow"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete field"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_clear"
        android:tint="@color/colorTextTertiary" />
</LinearLayout>
