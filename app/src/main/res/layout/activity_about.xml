<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorBackground"
        app:elevation="0dp"
        app:title="About SkyPay"
        app:titleTextColor="@color/colorTextPrimary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <!-- Hero Section -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="32dp"
                android:contentDescription="@string/app_name"
                app:srcCompat="@drawable/ic_skypay_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/colorTextPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Version 1.0.0 (Build 1)"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />

            <!-- Purpose Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_screen_margin"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/dp_screen_margin"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="@dimen/dp_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorCardBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Purpose &amp; Architecture"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/colorDivider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.5"
                        android:text="SkyPay operates as an automated payment listener bridge. It intercepts SMS payment notices from major carriers and banking apps, resolves critical transaction parameters, and forwards verified events through encrypted HTTP webhooks directly to merchant POS systems."
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Links Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_screen_margin"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/dp_screen_margin"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.06"
                android:text="OFFICIAL LINKS &amp; SUPPORT CHANNELS"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Website Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWebsite"
                style="@style/Widget.SkyPay.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_button_height"
                android:layout_marginStart="@dimen/dp_screen_margin"
                android:layout_marginEnd="@dimen/dp_screen_margin"
                android:layout_marginBottom="12dp"
                android:text="Visit Public Website"
                app:icon="@drawable/ic_globe"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/colorPrimary" />

            <!-- Telegram Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTelegram"
                style="@style/Widget.SkyPay.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_button_height"
                android:layout_marginStart="@dimen/dp_screen_margin"
                android:layout_marginEnd="@dimen/dp_screen_margin"
                android:layout_marginBottom="12dp"
                android:strokeColor="#229ED9"
                android:text="Contact on Telegram"
                android:textColor="#229ED9"
                app:icon="@drawable/ic_telegram"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="#229ED9" />

            <!-- WhatsApp Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhatsapp"
                style="@style/Widget.SkyPay.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_button_height"
                android:layout_marginStart="@dimen/dp_screen_margin"
                android:layout_marginEnd="@dimen/dp_screen_margin"
                android:layout_marginBottom="24dp"
                android:strokeColor="#25D366"
                android:text="Contact on WhatsApp"
                android:textColor="#25D366"
                app:icon="@drawable/ic_whatsapp"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="#25D366" />

            <!-- Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="32dp"
                android:text="SkyPay Technologies Inc. • All Rights Reserved"
                android:textColor="@color/colorTextTertiary"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
