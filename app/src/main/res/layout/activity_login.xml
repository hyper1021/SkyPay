<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_login">

    <!-- Floating Background Bubble 1 (Top-Right) -->
    <ImageView
        android:id="@+id/bubble1"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.18"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_bubble_layer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Floating Background Bubble 2 (Bottom-Left) -->
    <ImageView
        android:id="@+id/bubble2"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="100dp"
        android:alpha="0.12"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_bubble_layer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Floating Background Bubble 3 (Mid-Left) -->
    <ImageView
        android:id="@+id/bubble3"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:alpha="0.10"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_bubble_layer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.3" />

    <!-- Main Scrollable Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="36dp">

            <!-- Logo & Ambient Halo Ring -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:alpha="0.30"
                    android:importantForAccessibility="no"
                    android:src="@drawable/bg_bubble_layer" />

                <ImageView
                    android:id="@+id/ivLoginLogo"
                    android:layout_width="@dimen/login_logo_size"
                    android:layout_height="@dimen/login_logo_size"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    app:srcCompat="@drawable/ic_skypay_logo" />
            </FrameLayout>

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="SkyPay Gateway"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Device Authentication &amp; Listener"
                android:textColor="#8BA0C0"
                android:textSize="12sp" />

            <!-- Login Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#12233D"
                app:cardCornerRadius="@dimen/dp_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="#1E3A5C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- Account Email Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Email"
                        android:textColor="#8BA0C0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etLoginEmail"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_input_height"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field_login"
                        android:hint="merchant@domain.com"
                        android:importantForAutofill="no"
                        android:inputType="textEmailAddress"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#E6F0FF"
                        android:textColorHint="#5B7494"
                        android:textSize="14sp" />

                    <!-- Device Key Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Device Authorization Key"
                        android:textColor="#8BA0C0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etLoginDeviceKey"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_input_height"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field_login"
                        android:hint="••••••••••••"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#E6F0FF"
                        android:textColorHint="#5B7494"
                        android:textSize="14sp" />

                    <!-- Remember Me CheckBox -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbRememberMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:checked="true"
                        android:text="Remember Device"
                        android:textColor="#8BA0C0"
                        android:textSize="13sp"
                        app:buttonTint="@color/colorPrimary" />

                    <!-- Sign In Action Container -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogin"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_button_height"
                            android:background="@drawable/bg_btn_primary_gradient"
                            android:text="Sign In"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:cornerRadius="14dp"
                            app:elevation="2dp" />

                        <ProgressBar
                            android:id="@+id/pbLoginLoading"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="#FFFFFF"
                            android:visibility="gone" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Help Link -->
            <LinearLayout
                android:id="@+id/layoutLoginHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvLoginHelp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How does device authentication work? Need Help"
                    android:textColor="#4C9AFF"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
