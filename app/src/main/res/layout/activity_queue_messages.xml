<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorBackground"
        app:elevation="0dp"
        app:title="Pending Queue"
        app:titleTextColor="@color/colorTextPrimary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorDivider" />

    <!-- Queue Status Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/dp_screen_margin"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvQueueCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="0 Queued"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearAllQueue"
                style="@style/Widget.SkyPay.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:strokeColor="@color/colorDanger"
                android:text="Clear"
                android:textColor="@color/colorDanger"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryAllQueue"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_primary"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Retry All"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/layoutEmptyQueue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <com.airbnb.android.lottie.LottieAnimationView
            android:id="@+id/lottieEmptyQueue"
            android:layout_width="180dp"
            android:layout_height="180dp"
            app:lottie_autoPlay="true"
            app:lottie_fileName="lottie/emty.json"
            app:lottie_loop="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No Queued Messages"
            android:textColor="@color/colorTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:text="Messages that fail delivery will appear here and be automatically retried in the background."
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Queue List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQueueMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="6dp"
        android:paddingBottom="24dp" />

</LinearLayout>
