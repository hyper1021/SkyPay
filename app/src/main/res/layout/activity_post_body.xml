<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorBackground"
        app:elevation="0dp"
        app:title="Post Body Configuration"
        app:titleTextColor="@color/colorTextPrimary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingStart="@dimen/dp_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/dp_screen_margin"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1 Header: HTTP Method & Content Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.06"
                android:text="HTTP METHOD &amp; CONTENT TYPE"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Method + Content Type Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Method Selector Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutMethodSelector"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/colorCardBackground"
                    app:cardCornerRadius="@dimen/dp_card_radius_xs"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorCardBorder"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/tvSelectedMethod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="POST"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/colorTextTertiary" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Content Type Selector Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutContentTypeSelector"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/colorCardBackground"
                    app:cardCornerRadius="@dimen/dp_card_radius_xs"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorCardBorder"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/tvSelectedContentType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Application JSON"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/colorTextTertiary" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Section 2 Header: Request Body Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="@dimen/dp_section_gap"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.06"
                android:text="REQUEST BODY KEY-VALUE GRID"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Key-Value Grid Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="@dimen/dp_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorCardBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Table Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorSearchBackground"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="KEY"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="VALUE (TEMPLATE)"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Spacing for action icon -->
                        <View
                            android:layout_width="24dp"
                            android:layout_height="1dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorDivider" />

                    <!-- Dynamic Row Container (Populated by KeyValueGridController) -->
                    <LinearLayout
                        android:id="@+id/layoutPostBodyGridContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Supported Variables Hint -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3"
                android:text="Supported place-holders: {sender}, {message}, {amount}, {trxid}, {sim}, {timestamp}, {device_id}, {auth_token}"
                android:textColor="@color/colorTextTertiary"
                android:textSize="12sp" />

            <!-- Save Post Body Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePostBody"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_button_height"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_btn_primary_gradient"
                android:text="Save Post Body Configuration"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="14dp"
                app:elevation="2dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
